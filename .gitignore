# ==================================================
# goodBuy team-wide ignore rules
# macOS / IntelliJ IDEA / VS Code
# Java 21 + Spring Boot + Gradle
# Python 3.11 + FastAPI
# Vue 3 + Vite + npm
# ==================================================

# OS
.DS_Store
.AppleDouble
.LSOverride

# IDE / editors
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~

# Ignore personal VS Code settings, but allow shared project settings.
.vscode/
**/.vscode/

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
logs/
.goodbuy-runtime/

# Java / Spring Boot / Gradle
.gradle/
**/build/
!**/src/**/build/
!**/src/**/build/**
out/
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Gradle wrapper must remain version-controlled.
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Python virtual environments
ocrvenv/
venv/
.venv/
env/
.envdir/

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Python tooling / test output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.egg-info/
.eggs/
pip-wheel-metadata/
backend-python/**/__init__.py

# PaddleOCR / PaddleX cache
.paddlex/
.paddleocr/

# Python test and temporary image data only.
# Do not ignore images globally: frontend assets should be committed.
backend-python/tmp/
backend-python/temp/
backend-python/output/
backend-python/outputs/
backend-python/tests/fixtures/generated/
backend-python/tests/samples/*

# Never commit the personal OCR sample image.
**/[Uu]ser[Ee][Xx].png

# Node.js / Vue / Vite
node_modules/
dist/
dist-ssr/
.vite/
.cache/
coverage/
*.tsbuildinfo
.eslintcache
*.timestamp-*-*.mjs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend test output
cypress/videos/
cypress/screenshots/
__screenshots__/

# Local Docker overrides and runtime data
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml
docker-data/
.docker-data/

# Miscellaneous temporary files
*.tmp
*.temp
*.bak
*.pid
